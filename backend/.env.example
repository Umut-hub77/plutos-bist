# ==============================================================================
# PLUTOS BIST - GERÇEK SMS VE E-POSTA DOĞRULAMA AYARLARI (.env.example)
# ==============================================================================
# Bu dosyayı .env olarak kopyalayıp kendi SMS / SMTP bilgilerinizi girebilirsiniz.
# ==============================================================================

# 1. TÜRKİYE NETGSM SMS ENTEGRASYONU (Önerilen)
# https://www.netgsm.com.tr
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=PLUTOS

# 2. İLETİMERKEZİ SMS ENTEGRASYONU
# https://www.iletimerkezi.com
ILETIMERKEZI_KEY=
ILETIMERKEZI_HASH=
ILETIMERKEZI_SENDER=PLUTOS

# 3. TWILIO SMS ENTEGRASYONU (Uluslararası / Global)
# https://www.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# 4. SMTP E-POSTA DOĞRULAMA (Gmail / Outlook / Kurumsal SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Plutos BIST <noreply@plutos-bist.com>
